{
  "_doc": "9 维度本地化评估打分配置。每维度 1-5 分，加权求和满分 45。规则版打分（无 LLM）：通过关键词命中 + 来源权重 + 话题命中度推断各维度。",

  "_version": "v1.0",

  "weights": {
    "A_strategy_fit":      1.2,
    "B_user_match":        1.0,
    "C_portability":       1.1,
    "D_cost_inverse":      0.9,
    "E_cycle_fit":         0.8,
    "F_differentiation":   1.0,
    "G_pay_drive":         1.1,
    "H_voice":             0.9,
    "I_risk_inverse":      1.0
  },

  "tiers": {
    "S": { "min": 36, "label": "强烈推荐 · 战略级" },
    "A": { "min": 32, "label": "可立项 · 进策划评审" },
    "B": { "min": 28, "label": "差异化借鉴 · 排进版本" },
    "C": { "min": 22, "label": "存档参考" },
    "D": { "min":  0, "label": "忽略" }
  },

  "_scoring_rules": "每个维度起始 3 分（中性），按关键词命中在 1-5 之间调整。以下为通用示例，请根据你的产品和品类调整关键词。",

  "dimensions": {
    "A_strategy_fit": {
      "_desc": "战略契合度：是否匹配当前产品的核心系统方向",
      "boost": {
        "+2": ["更新", "版本", "新系统", "新玩法"],
        "+1": ["公告", "维护", "上线"]
      },
      "penalty": {
        "-1": ["赛事", "电竞", "PV预告", "周边"]
      }
    },
    "B_user_match": {
      "_desc": "用户匹配度：是否匹配目标用户画像",
      "boost": {
        "+2": ["经典", "怀旧", "情怀"],
        "+1": ["IP", "联动"]
      },
      "penalty": {
        "-1": ["低幼", "Q版"]
      }
    },
    "C_portability": {
      "_desc": "玩法可迁移性：能否低成本复用到已有模块",
      "boost": {
        "+2": ["签到", "兑换码", "分享", "积分"],
        "+1": ["商城", "活动", "邮件"]
      },
      "penalty": {
        "-2": ["全新引擎", "重做", "云游戏"],
        "-1": ["大DAU", "电竞联赛", "线下"]
      }
    },
    "D_cost_inverse": {
      "_desc": "实施成本（反向：成本越低分越高）",
      "boost": {
        "+2": ["签到", "充值送", "兑换码", "邮件发放"],
        "+1": ["投票", "文案活动", "复刻", "返场"]
      },
      "penalty": {
        "-2": ["新副本", "新职业", "新地图", "明星代言"],
        "-1": ["新玩法", "大版本", "美术升级"]
      }
    },
    "E_cycle_fit": {
      "_desc": "周期合理性：是否匹配周/月/季节奏",
      "boost": {
        "+2": ["周年", "节日", "春节", "国庆"],
        "+1": ["每周", "周更", "限时", "倒计时"]
      },
      "penalty": {
        "-1": ["延期", "下架", "取消"]
      }
    },
    "F_differentiation": {
      "_desc": "差异化潜力",
      "boost": {
        "+2": ["联动", "跨界", "IP合作"],
        "+1": ["创新", "首创", "独家"]
      },
      "penalty": {
        "-1": ["同质化", "抄袭"]
      }
    },
    "G_pay_drive": {
      "_desc": "付费拉动力：直接拉 ARPU 的玩法",
      "boost": {
        "+2": ["首充", "月卡", "战令", "通行证", "充值返利"],
        "+1": ["VIP", "充值", "付费"]
      },
      "penalty": {
        "-1": ["免费", "0氪", "零氪"]
      }
    },
    "H_voice": {
      "_desc": "用户声量：出圈与传播潜力",
      "boost": {
        "+2": ["热搜", "破圈", "刷屏", "出圈"],
        "+1": ["明星", "代言", "联名", "PV"]
      },
      "penalty": {}
    },
    "I_risk_inverse": {
      "_desc": "风险等级（反向：风险越低分越高）",
      "boost": {
        "+1": ["官方授权", "正版", "合规"]
      },
      "penalty": {
        "-2": ["违规", "投诉", "退款", "封号", "敏感"],
        "-1": ["争议", "差评", "玩家不满"]
      }
    }
  },

  "source_weight_bias": {
    "_doc": "不同 source 对各维度的初始倾向（在打分基础上再 ±0.5）",
    "official": { "A_strategy_fit": 0.5, "I_risk_inverse": 0.5 },
    "wechat":   { "H_voice": 0.5 },
    "hykb":     { "B_user_match": 0.3 },
    "taptap":   { "B_user_match": 0.3, "H_voice": 0.3 }
  },

  "industry_filter": {
    "_doc": "industry 类竞品默认所有维度 -1 分（行业号信号弱），不参与 TOP 推荐",
    "demote_score": -3
  },

  "mount_points": {
    "_doc": "可挂载模块列表，根据你的项目自定义",
    "modules": [
      "活动模块",
      "签到日历",
      "商城系统",
      "邮件系统",
      "成就系统",
      "UGC共创",
      "回流活动"
    ]
  }
}
