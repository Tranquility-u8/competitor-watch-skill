        "+1": ["官方授权", "正版", "IP合作", "合规"]
      },
      "penalty": {
        "-2": ["擦边", "灰产", "私服", "外挂", "投诉", "退款", "封号", "敏感", "违规", "舆情"],
        "-1": ["争议", "差评", "玩家不满", "跳楼", "维权"]
