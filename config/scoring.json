{
  "_doc": "9 维度本地化评估打分配置（参考 4 月 PPT《MMO 竞品监测·本地化落地实战》）。每维度 1-5 分，加权求和满分 45。规则版打分（无 LLM）：通过关键词命中 + 来源权重 + 话题命中度推断各维度。",

  "_version": "v1.0",
  "_target_project": "",

  "weights": {
    "A_strategy_fit":      1.2,
    "B_user_match":        1.0,
    "C_portability":       1.1,
    "D_cost_inverse":      0.9,
    "E_cycle_fit":         0.8,
    "F_differentiation":   1.0,
    "G_pay_drive":         1.1,
    "H_voice":             0.9,
    "I_risk_inverse":      1.0
  },

  "tiers": {
    "S": { "min": 36, "label": "强烈推荐 · 战略级" },
    "A": { "min": 32, "label": "可立项 · 进策划评审" },
    "B": { "min": 28, "label": "差异化借鉴 · 排进版本" },
    "C": { "min": 22, "label": "存档参考" },
    "D": { "min":  0, "label": "忽略" }
  },

  "_scoring_rules": "每个维度起始 3 分（中性），按以下规则在 1-5 之间调整。",

  "dimensions": {
    "A_strategy_fit": {
      "_desc": "战略契合度：是否匹配自家产品当前核心系统焦点",
      "boost": {
        "+2": ["血盟", "帮派", "帮战", "直购", "赛季礼包", "成就", "首充", "月卡", "礼包", "周年"],
        "+1": ["更新公告", "维护公告", "版本更新", "新版本", "新内容", "上线", "开服"]
      },
      "penalty": {
        "-1": ["赛事", "电竞", "PV预告", "立绘", "原画", "壁纸", "周边"]
      }
    },
    "B_user_match": {
      "_desc": "用户匹配度：是否匹配目标用户画像",
      "boost": {
        "+2": ["国风", "武侠", "仙侠", "怀旧服", "情怀", "经典", "端游", "回忆"],
        "+1": ["MMO", "PK", "国战", "门派", "江湖", "侠义"]
