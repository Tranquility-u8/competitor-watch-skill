      "penalty": {
        "-2": ["全新引擎", "重做", "云游戏", "AI生成", "NeRF", "UE5迁移"],
        "-1": ["大DAU", "电竞联赛", "线下盛典", "千万投入"]
      }
    },
    "D_cost_inverse": {
      "_desc": "实施成本（反向：成本越低分越高）",
